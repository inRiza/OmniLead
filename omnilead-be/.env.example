# Salin ke .env lalu isi. Jangan commit .env.

OMNILEAD_SECRETS_DIR=.secrets
OMNILEAD_DB_PATH=data/omnilead.db
OMNILEAD_CORS_ORIGINS=["http://localhost:3000"]

# --- Instagram API with Instagram Login (akun Professional milik tim) ---
# App tipe Business di https://developers.facebook.com/apps, produk Instagram,
# menu "API setup with Instagram business login" -> Generate token.
# Host: graph.instagram.com. Izin: instagram_business_basic,
# instagram_business_manage_comments (+ ..._manage_messages untuk DM).
# USER_ID: GET https://graph.instagram.com/v26.0/me?fields=user_id,username
OMNILEAD_INSTAGRAM_USER_ID=
OMNILEAD_INSTAGRAM_ACCESS_TOKEN=
OMNILEAD_INSTAGRAM_GRAPH_VERSION=v26.0
