# Salin ke .env lalu isi. Jangan commit .env.

OMNILEAD_SECRETS_DIR=.secrets
OMNILEAD_DB_PATH=data/omnilead.db
OMNILEAD_CORS_ORIGINS=["http://localhost:3000"]

# Kunci API untuk FE (header X-API-Key). Kosong = tanpa autentikasi (hanya dev).
OMNILEAD_API_KEY=

# --- Service agen (omnilead-agent), dipanggil oleh BE ---
OMNILEAD_AGENT_URL=http://localhost:8100
# Harus sama dengan OMNILEAD_AGENT_API_KEY di service agen (boleh kosong di dev).
OMNILEAD_AGENT_API_KEY=
# key = X-API-Key saja; oidc = tambah token identitas Google (agen tidak publik di Cloud Run)
OMNILEAD_AGENT_AUTH=key

# --- Instagram Graph API (akun Professional milik tim, Standard Access) ---
# App di https://developers.facebook.com/apps ; produk Instagram Graph API.
# Izin: instagram_business_manage_comments, instagram_business_manage_messages.
OMNILEAD_INSTAGRAM_USER_ID=
OMNILEAD_INSTAGRAM_ACCESS_TOKEN=
OMNILEAD_INSTAGRAM_GRAPH_VERSION=v21.0

# --- LinkedIn: Share on LinkedIn (resmi, self-serve, scope w_member_social) ---
# App di https://www.linkedin.com/developers/apps ; produk "Share on LinkedIn"
# + "Sign In with LinkedIn using OpenID Connect".
OMNILEAD_LINKEDIN_CLIENT_ID=
OMNILEAD_LINKEDIN_CLIENT_SECRET=
OMNILEAD_LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
OMNILEAD_LINKEDIN_API_VERSION=202609

# --- Penyimpanan: sqlite (dev/tes) atau firestore (produksi; pasang extra: uv sync --extra firestore) ---
OMNILEAD_STORE=sqlite
OMNILEAD_FIRESTORE_PROJECT=

# --- Meta: WhatsApp Cloud API (nomor uji) + webhook Instagram ---
OMNILEAD_META_APP_SECRET=
OMNILEAD_META_VERIFY_TOKEN=
OMNILEAD_WHATSAPP_PHONE_NUMBER_ID=
OMNILEAD_WHATSAPP_ACCESS_TOKEN=
OMNILEAD_WHATSAPP_GRAPH_VERSION=v21.0

# --- Gmail API (OAuth mode Testing; refresh token milik test user) ---
OMNILEAD_GMAIL_CLIENT_ID=
OMNILEAD_GMAIL_CLIENT_SECRET=
OMNILEAD_GMAIL_REFRESH_TOKEN=
OMNILEAD_GMAIL_PUBSUB_TOPIC=
OMNILEAD_GMAIL_PUSH_TOKEN=

# --- Cloud Scheduler: token Bearer, atau audience OIDC. Keduanya kosong = endpoint ditutup ---
OMNILEAD_SCHEDULER_TOKEN=
OMNILEAD_SCHEDULER_OIDC_AUDIENCE=
