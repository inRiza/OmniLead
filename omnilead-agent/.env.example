# Salin ke .env lalu isi. Jangan commit .env.
OMNILEAD_AGENT_CATALOG_PATH=data/catalog.json
# rule = templat deterministik (tanpa LLM). adk = orchestrator Google ADK + Gemini.
OMNILEAD_AGENT_ENGINE=rule
OMNILEAD_AGENT_MODEL=gemini-flash-latest
# Untuk engine adk: GOOGLE_API_KEY=... atau Vertex AI:
# GOOGLE_GENAI_USE_VERTEXAI=1
# GOOGLE_CLOUD_PROJECT=...
# GOOGLE_CLOUD_LOCATION=asia-southeast2
# Kosongkan untuk mematikan autentikasi (hanya dev). Harus sama dengan OMNILEAD_AGENT_API_KEY di BE.
OMNILEAD_AGENT_API_KEY=
